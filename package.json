{
  "name": "scoretech-identity",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lab": "bash ./lab",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:tooling",
    "test:tooling": "node --test tests/unit/*.test.mjs tests/deployment/*.test.mjs",
    "test:deployment": "node --test tests/deployment/*.test.mjs",
    "test:deployment:first-boot": "node tests/deployment/first-boot.mjs",
    "lint": "pnpm -r lint",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "test:e2e": "node tests/e2e/triplet.mjs",
    "provider:test": "mvn --batch-mode --no-transfer-progress -f provider/providers/email-otp/pom.xml test",
    "test:e2e:sso": "node tests/e2e/external-sso.mjs",
    "test:e2e:session": "node tests/e2e/session-resume.mjs",
    "test:e2e:profile": "node tests/e2e/account-profile.mjs",
    "test:e2e:catalogue": "node tests/e2e/native-catalogue.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "yaml": "2.8.1",
    "prettier": "3.4.2"
  }
}
