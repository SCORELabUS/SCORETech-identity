APP_PORT=8080
APP_LOG_LEVEL=debug
APP_SERVICE_VERSION=0.3.0
APP_CORS_ORIGINS=http://localhost:5173

# Staging Keycloak realm used by local development.
APP_KEYCLOAK_ISSUER=https://staging-identity.tentuplaza.es/realms/tentuplaza
APP_KEYCLOAK_ADMIN_URL=https://staging-identity.tentuplaza.es
APP_KEYCLOAK_REALM=tentuplaza
APP_KEYCLOAK_AUDIENCE=identity-admin-api
APP_KEYCLOAK_ADMIN_CLIENT_ID=identity-admin-service

# Obtain this secret from the Keycloak client configuration. Never commit it.
APP_KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-keycloak-service-client-secret

# Personal portal: also add http://localhost:5174 to APP_CORS_ORIGINS.
# Optional WooCommerce integration: credentials must stay in this ignored .env.
# APP_WOO_URL=https://your-shop.example
# APP_WOO_STORE_ID=tentuplaza
# APP_WOO_KEY=
# APP_WOO_SECRET=
# APP_WOO_WEBHOOK_SECRET=

# Git catalogue editor: GitHub App installed only on the GitOps repository.
APP_IDENTITY_ENVIRONMENT=staging
APP_CATALOGUE_REPO=TenTuPlaza/tentu-gitops
APP_CATALOGUE_BRANCH=main
# APP_GITHUB_APP_ID=
# APP_GITHUB_INSTALLATION_ID=
# APP_GITHUB_PRIVATE_KEY=
# Optional read-only Argo CD status verification (HTTPS).
# APP_ARGOCD_URL=https://argocd.example
# APP_ARGOCD_TOKEN=
# Enable after SMTP and the public client's redirect URLs are configured.
APP_WOO_SEND_ACTIVATION=false
APP_ACTIVATION_LIFESPAN_SECONDS=3600
APP_ACCOUNT_CLIENT_ID=identity-account-web
# APP_ACCOUNT_PUBLIC_URL=https://id.example
# Private S3 bucket for avatar photos. Local development can omit it; photos then stay disabled.
# APP_AVATAR_BUCKET=tentuplaza-avatars-123456789012

# Optional opposition/ranking administration gateways. No credentials here.
# OPPOSITIONS_API_URL=http://localhost:8182
# RANKING_API_URL=http://localhost:8183
