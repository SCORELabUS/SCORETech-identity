APP_PORT=8080
APP_LOG_LEVEL=info
APP_CORS_ORIGINS=http://localhost:18000
APP_KEYCLOAK_ISSUER=http://localhost:18000/identity/auth/realms/score
APP_KEYCLOAK_TRANSPORT_URL=http://localhost:18000/identity/auth/realms/score
APP_KEYCLOAK_ADMIN_URL=http://localhost:18000/identity/auth
APP_KEYCLOAK_REALM=score
APP_KEYCLOAK_AUDIENCE=identity-admin-api
APP_KEYCLOAK_ADMIN_CLIENT_ID=identity-admin-service
# Set a private service credential, or APP_KEYCLOAK_ADMIN_CLIENT_SECRET_FILE.
APP_KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-keycloak-service-client-secret
APP_IDENTITY_ENVIRONMENT=local
APP_REQUIRE_ADMIN_PASSKEY=true
APP_ACTIVATION_LIFESPAN_SECONDS=3600
APP_ACCOUNT_CLIENT_ID=identity-account-web
APP_ACCOUNT_PUBLIC_URL=http://localhost:18000/identity/account/
