# Legacy root entry point. Prefer docker/production/.env (see docker/README.md).
# Private configuration. Run ./docker/setup production from the repository root, then edit .env.
# Paths below are relative to the repository root, not this directory.
IDENTITY_PUBLIC_ORIGIN=https://sphere.score.us.es
IDENTITY_ENVIRONMENT=production
IDENTITY_WEBAUTHN_RP_ID=sphere.score.us.es
IDENTITY_BOOTSTRAP_EMAIL=replace-with-first-operator@example.org
IDENTITY_RUNTIME_PATH=./.identity-runtime
IDENTITY_GATEWAY_PORT=18010
IDENTITY_GATEWAY_ALIAS=scoretech-identity-gateway
# Existing SPHERE network: docker network ls (default when launched from docker/production).
SPHERE_DOCKER_NETWORK=production_sphere-network
# Published by the verified main CI. Pin sha-<full commit SHA> for a controlled release.
IDENTITY_IMAGE_PREFIX=ghcr.io/scorelabus/scoretech-identity
IDENTITY_VERSION=main
IDENTITY_PROVIDER_MEMORY=2g

# Generated once by docker/setup. Never change these on an existing database casually.
IDENTITY_DATABASE_PASSWORD=
IDENTITY_BOOTSTRAP_PASSWORD=
IDENTITY_ADMIN_CLIENT_SECRET=
IDENTITY_ACCOUNT_CLIENT_SECRET=
IDENTITY_SYNC_CLIENT_SECRET=

IDENTITY_GITHUB_APP_ID=replace
IDENTITY_GITHUB_INSTALLATION_ID=replace
IDENTITY_GITHUB_KEY_FILE=./docker/production/secrets/github-app.pem
IDENTITY_CATALOGUE_REPO=SCORELabUS/SCORETech-identity
IDENTITY_CATALOGUE_BRANCH=identity-catalogue
# Use Brevo SMTP credentials (not its HTTP API key).
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=replace-with-authenticated-sender@example.org
BREVO_SENDER_NAME=SCORETech Identity

# Published documents: sha256:<64 hexadecimal characters> of each approved version.
IDENTITY_TERMS_URL=https://replace.example.org/terms
IDENTITY_TERMS_VERSION=replace
IDENTITY_TERMS_DIGEST=sha256:replace-with-published-document-digest
IDENTITY_PRIVACY_URL=https://replace.example.org/privacy
IDENTITY_PRIVACY_VERSION=replace
IDENTITY_PRIVACY_DIGEST=sha256:replace-with-published-document-digest
