{
  "name": "@scoretech/identity-internal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "lint": "eslint . --ext .ts",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' '*.json' '*.js'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' '*.json' '*.js'",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test": "vitest run --maxWorkers=1 --minWorkers=1"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^5.10.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "MIT"
}
